<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SimpleEmployeeApp.ViewModels"
             x:Class="SimpleEmployeeApp.Views.MainPage"
             x:Name="EmployeePage"
             Title="Employees"
             BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.BindingContext>
        <viewModels:MainViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='20,28,20,24', Default='40,36,40,30'}" Spacing="24">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Employee directory" Style="{StaticResource PageTitle}" />
                    <Label Text="Manage your team from one simple workspace" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
                <Border Grid.Column="1" BackgroundColor="{StaticResource Primary}" StrokeThickness="0" Padding="14,10" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Label Text="TEAM" TextColor="{StaticResource Black}" FontFamily="OpenSansSemibold" FontSize="12" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border BackgroundColor="{StaticResource CardBackground}" Padding="16" Stroke="{StaticResource Gray200}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="DIRECTORY" Style="{StaticResource Caption}" FontFamily="OpenSansSemibold" />
                        <Label Text="All employees" TextColor="{StaticResource Gray950}" FontFamily="OpenSansSemibold" FontSize="17" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="#EEF2FF" Padding="16" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="WORKSPACE" Style="{StaticResource Caption}" TextColor="{StaticResource Black}" FontFamily="OpenSansSemibold" />
                        <Label Text="People first" TextColor="{StaticResource Gray950}" FontFamily="OpenSansSemibold" FontSize="17" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" BackgroundColor="#ECFDF5" Padding="16" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="STATUS" Style="{StaticResource Caption}" TextColor="#059669" FontFamily="OpenSansSemibold" />
                        <Label Text="Up to date" TextColor="{StaticResource Gray950}" FontFamily="OpenSansSemibold" FontSize="17" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Border BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Gray200}" Padding="4,0" HeightRequest="52">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <SearchBar Placeholder="Search by name or department" TextColor="{StaticResource Black}" PlaceholderColor="{StaticResource Black}" Text="{Binding SearchText}" />
                </Border>
                <Button Grid.Column="1" Text="＋  Add employee" Command="{Binding AddCommand}" Padding="18,0" />
            </Grid>

            <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='1.15*,0.85*'}" ColumnSpacing="20">
                <VerticalStackLayout Grid.Column="0" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Your employees" Style="{StaticResource SectionTitle}" />
                        <Label Grid.Column="1" Text="Select a person to edit" Style="{StaticResource Caption}" VerticalOptions="End" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Employees}"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedEmployee}"
                                    SelectionChanged="OnEmployeeSelectionChanged"
                                    EmptyView="No employees match your search.">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Gray200}" Padding="14,12" Opacity="1">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                                        <Border BackgroundColor="#EEF2FF" StrokeThickness="0" HeightRequest="48" WidthRequest="48" Padding="0">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                                            <Label Text="{Binding FirstName}" TextColor="{StaticResource Primary}" FontFamily="OpenSansSemibold" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding FullName}" TextColor="{StaticResource Gray950}" FontFamily="OpenSansSemibold" FontSize="16" />
                                            <Label Text="{Binding Position}" Style="{StaticResource Caption}" />
                                            <Label Text="{Binding Department}" TextColor="{StaticResource Black}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2" BackgroundColor="#ECFDF5" StrokeThickness="0" Padding="9,5" VerticalOptions="Center" IsVisible="{Binding IsActive}">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                            <Label Text="Active" TextColor="#059669" FontSize="11" FontFamily="OpenSansSemibold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <Border x:Name="EditPanel" Grid.Column="1" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Gray200}" Padding="24" IsVisible="{Binding IsEditing}" VerticalOptions="Start">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Employee details" Style="{StaticResource SectionTitle}" />
                            <Label Text="Add or update profile information" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="5"><Label Text="First name" Style="{StaticResource Caption}" /><Border Stroke="{StaticResource Gray200}" Padding="8,0" HeightRequest="44"><Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape><Entry Text="{Binding CurrentEmployee.FirstName}" Placeholder="e.g. Alex" /></Border></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5"><Label Text="Last name" Style="{StaticResource Caption}" /><Border Stroke="{StaticResource Gray200}" Padding="8,0" HeightRequest="44"><Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape><Entry Text="{Binding CurrentEmployee.LastName}" Placeholder="e.g. Morgan" /></Border></VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Spacing="5"><Label Text="Email" Style="{StaticResource Caption}" /><Border Stroke="{StaticResource Gray200}" Padding="8,0" HeightRequest="44"><Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape><Entry Text="{Binding CurrentEmployee.Email}" Placeholder="name@company.com" Keyboard="Email" /></Border></VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="5"><Label Text="Department" Style="{StaticResource Caption}" /><Border Stroke="{StaticResource Gray200}" Padding="8,0" HeightRequest="44"><Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape><Entry Text="{Binding CurrentEmployee.Department}" Placeholder="Department" /></Border></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5"><Label Text="Position" Style="{StaticResource Caption}" /><Border Stroke="{StaticResource Gray200}" Padding="8,0" HeightRequest="44"><Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape><Entry Text="{Binding CurrentEmployee.Position}" Placeholder="Position" /></Border></VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Spacing="5"><Label Text="Salary" Style="{StaticResource Caption}" /><Border Stroke="{StaticResource Gray200}" Padding="8,0" HeightRequest="44"><Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape><Entry Text="{Binding CurrentEmployee.Salary}" Placeholder="Annual salary" Keyboard="Numeric" /></Border></VerticalStackLayout>
                        <HorizontalStackLayout Spacing="8"><CheckBox IsChecked="{Binding CurrentEmployee.IsActive}" /><Label Text="Active employee" TextColor="{StaticResource Gray600}" VerticalOptions="Center" /></HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0"><Button Text="Save changes" Command="{Binding SaveCommand}" /><Button Grid.Column="1" Text="Cancel" Command="{Binding CancelCommand}" BackgroundColor="{StaticResource Gray100}" TextColor="{StaticResource Gray600}" /></Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>